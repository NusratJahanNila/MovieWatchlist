// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js" // Fixed typo here
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  // Relationships
  movies         Movie[]         @relation("MovieCreator")
  watchlistItems WatchlistItem[] // Added missing back-relation for WatchlistItem
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  overview    String?  // Optional field
  releaseYear Int
  genre       String[] @default([]) // Array of strings
  runtime     Int?
  posterUrl   String?
  createdBy   String
  createdAt   DateTime @default(now())

  // Relationships
  creator        User            @relation("MovieCreator", fields: [createdBy], references: [id], onDelete: Cascade) // Named the relation to match User model
  watchlistItems WatchlistItem[]
}

model WatchlistItem {
  id        String          @id @default(uuid())
  userId    String
  movieId   String
  status    WatchlistStatus @default(PLANNED) // Enum field
  rating    Int?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt // Changed @default(now()) to @updatedAt so it automatically updates

  // Relationships
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // Optional Bonus: Ensures a user can't add the same movie to their watchlist twice
  @@unique([userId, movieId]) 
}

// Define the WatchlistStatus enum
enum WatchlistStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}